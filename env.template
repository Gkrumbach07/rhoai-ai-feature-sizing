# LLM Provider Configuration
LLM_PROVIDER=openai  # Options: openai, anthropic, ollama
EMBEDDING_PROVIDER=openai  # Options: openai, huggingface, ollama

# OpenAI API Configuration (when using openai provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE="https://api.openai.com/v1/"

# Anthropic API Configuration (when using anthropic provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Configuration (when using ollama provider)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: GitHub token for accessing repositories for RAG data
GITHUB_TOKEN=your_github_token_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: Custom model configurations
OPENAI_MODEL=gpt-4
EMBEDDING_MODEL=text-embedding-3-small

# RAG Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Optional: RAG Configuration
RAG_TOP_K=10
MAX_CONTEXT_LENGTH=8000

# Optional: Agent Configuration
ENABLE_ALL_AGENTS=true
MAX_SYNTHESIS_ITERATIONS=3

# DeepWiki MCP (Model Context Protocol) Configuration
ENABLE_DEEPWIKI_MCP=true
DEEPWIKI_MCP_URL=https://mcp.deepwiki.com/sse
DEEPWIKI_MCP_PROTOCOL=sse  # Options: sse, mcp
DEEPWIKI_MCP_TIMEOUT=30
DEEPWIKI_MCP_MAX_RETRIES=3
DEEPWIKI_MCP_FALLBACK=true  # Use fallback responses when MCP server unavailable
DEEPWIKI_MCP_DEMO_MODE=false  # Use demo responses for testing (overrides server requests)

# Optional: Default repositories for MCP research (comma-separated)
# Leave empty to use built-in defaults for OpenShift AI research
MCP_DEFAULT_REPOS=https://github.com/kubeflow/kubeflow,https://github.com/kserve/kserve,https://github.com/opendatahub-io/opendatahub-operator

# Jira Integration Configuration
JIRA_BASE_URL=https://issues.redhat.com
JIRA_PROJECT_KEY=RHOAI
JIRA_USERNAME=your_jira_username_here
JIRA_API_TOKEN=your_jira_api_token_here

# API Server Configuration
REACT_APP_API_URL=http://localhost:8001
